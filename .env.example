# naturalvoice — copy to .env and fill in your keys
# cp .env.example .env

# --- Core demo (baseline: Deepgram + ElevenLabs) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
DAILY_API_KEY=

# Optional: pre-created Daily room
# DAILY_ROOM_URL=
# DAILY_TOKEN=

# --- UltraVoice (primary stack for run_demo.py) ---
ULTRAVOICE_ASR_KEY=              # sk-... from UltraVoice dashboard → Speech-to-Text → API Keys
ULTRAVOICE_TTS_VOICE_ID=         # preset or cloned voice ID from USF Mini TTS
# ULTRAVOICE_TTS_URL=https://api.us.tech/v1/tts/synthesize
# USF_ASR_BASE_URL=wss://api-asr.us.tech/v1/audio/transcriptions/stream

# Legacy aliases (still supported)
# ULTRAVOICE_API_KEY=
# ULTRAVOICE_VOICE_ID=

# --- Engine selection (demo/run_demo.py) ---
TTS_ENGINE=ultravoice            # ultravoice | elevenlabs | fish_audio
USE_USF_ASR=false                 # true → swap Deepgram for USF ASR (Deepgram-compatible wire)
FILLER_INTENSITY=0.7              # 0.0 = minimal fillers, 1.0 = maximum naturalness

# --- Turn Manager ---
# TURN_PATIENCE_MS=600
# TURN_DEBUG=1
# BACKCHANNEL_VOICE=elevenlabs    # or ultravelabs when TTS_ENGINE=ultravoice

# --- Ambient Layer ---
# AMBIENT_PROFILE=restaurant
# AMBIENT_MIX_LEVEL=0.15

# --- Fallback TTS ---
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=
